{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "types": ["node"],
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@core/*": ["./src/core/src/*"]
    }
  },
  "include": [
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.tsx",
    "src/preload/index.d.ts",
    "src/renderer/src/vite-env.d.ts",
    "src/core/src/**/*.ts"
  ],
  "exclude": [
    "src/core/src/**/*.test.ts",
    "src/core/src/index.ts",
    "src/core/src/persistence/**",
    "src/core/src/scanning/repositoryScanner.ts",
    "src/core/src/report/outputPath.ts"
  ]
}
